{
  "editor.accessibilitySupport": "off",
  "editor.fontFamily": "MonolisaCode, 'PragmataPro Mono Liga', 'Jetbrains Mono', Menlo",
  "editor.fontLigatures": true,
  "editor.fontSize": 15,
  "editor.fontVariations": true,
  "editor.lineHeight": 20,
  "editor.lineNumbers": "relative",
  "editor.minimap.enabled": false,
  "extensions.ignoreRecommendations": true,
  "json.schemaDownload.enable": true,
  "kiroAgent.agentAutonomy": "Supervised",
  "kiroAgent.trustedCommands": [
    "mvn clean compile",
    "mvn test",
    "mvn compile -q"
  ],
  "telemetry.dataSharingAndPromptLogging.contentCollectionForServiceImprovement": false,
  "telemetry.dataSharingAndPromptLogging.usageAnalyticsAndPerformanceMetrics": false,
  "telemetry.feedback.enabled": false,
  "terminal.integrated.fontFamily": "'Monolisa Nerd Font', 'Jetbrains Mono', Menlo",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontSize": 14,
  "vim.commandLineModeKeyBindings": [],
  "vim.digraphs": {},
  "vim.easymotion": true,
  "vim.handleKeys": {
    "<C-d>": true,
    "<C-s>": false,
    "<C-z>": false
  },
  "vim.highlightedyank.enable": true,
  "vim.hlsearch": true,
  "vim.leader": "<space>",
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<leader>",
        "w"
      ],
      "after": [
        "<leader><leader>",
        "w"
      ]
    },
    {
      "before": [
        "<leader>",
        "b"
      ],
      "after": [
        "<leader><leader>",
        "b"
      ]
    },
    {
      "before": [
        "<leader>",
        "e",
        "e"
      ],
      "commands": [
        "workbench.action.toggleSidebarVisibility"
      ]
    },
    {
      "before": [
        "<leader>",
        "e",
        "f"
      ],
      "commands": [
        "workbench.files.action.showActiveFileInExplorer"
      ]
    },
    {
      "before": [
        "<leader>",
        "e",
        "r"
      ],
      "commands": [
        "workbench.files.action.refreshFilesExplorer"
      ]
    },
    {
      "before": [
        "<C-h>"
      ],
      "commands": [
        "workbench.action.focusLeftGroup"
      ]
    },
    {
      "before": [
        "<C-l>"
      ],
      "commands": [
        "workbench.action.focusRightGroup"
      ]
    },
    {
      "before": [
        "<C-j>"
      ],
      "commands": [
        "workbench.action.focusBelowGroup"
      ]
    },
    {
      "before": [
        "<C-k>"
      ],
      "commands": [
        "workbench.action.focusAboveGroup"
      ]
    },
    {
      "before": [
        "<leader>",
        "z",
        "z"
      ],
      "commands": [
        "workbench.action.toggleZenMode"
      ]
    },
    {
      "before": [
        "<leader>",
        "y"
      ],
      "after": [
        "\"",
        "+",
        "y"
      ]
    },
    {
      "before": [
        "<leader>",
        "p"
      ],
      "after": [
        "\"",
        "+",
        "p"
      ]
    }
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<leader>",
        "y"
      ],
      "after": [
        "\"",
        "+",
        "y"
      ]
    },
    {
      "before": [
        "<leader>",
        "p"
      ],
      "after": [
        "\"",
        "+",
        "p"
      ]
    }
  ],
  "vim.useSystemClipboard": false,
  "workbench.activityBar.location": "top",
  "workbench.colorTheme": "Dracula Pro",
  "workbench.iconTheme": "material-icon-theme",
  "window.autoDetectColorScheme": true,
  "workbench.preferredDarkColorTheme": "Dracula Pro (Van Helsing)",
  "workbench.preferredLightColorTheme": "Dracula Pro (Alucard)",
  "window.systemColorTheme": "auto",
  "claudeCode.preferredLocation": "panel",
  "kiroAgent.configureMCP": "Disabled",
  "chat.editor.fontFamily": "MonolisaCode, 'PragmataPro Mono Liga', Menlo",
  "chat.editor.fontSize": 15,
  "chat.fontSize": 15,
  "chat.fontFamily": "MonolisaCode, 'PragmataPro Mono Liga', Menlo",
  "window.zoomLevel": 1,
  "window.zoomPerWindow": false,
  "workbench.fontAliasing": "auto",
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "comment",
          "keyword",
          "variable.language",
          "variable.parameter",
          "storage.modifier",
          "entity.name.type.class"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  }
}
